<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The PowerShell worker process started by the GUI.
      net48 (x64): production. MilestonePSTools requires 64-bit Windows PowerShell 5.1 (manifest ProcessorArchitecture = Amd64).
      net8.0     : used by the end-to-end protocol tests with a mock module; never shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>MilestoneAdmin.Worker</AssemblyName>
    <RootNamespace>MilestoneAdmin.Worker</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MilestoneAdmin.Worker.Engine\MilestoneAdmin.Worker.Engine.csproj" />
  </ItemGroup>
</Project>
