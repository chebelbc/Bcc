<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MilestoneAdmin.UI.ViewModels"
                    xmlns:v="clr-namespace:MilestoneAdmin.UI.Views">
    <!-- Maps each page view model to its view (the shell shows the current page in a ContentControl). -->
    <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}"><v:SetupWizardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConnectViewModel}"><v:ConnectView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemViewModel}"><v:SystemView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecordingServersViewModel}"><v:RecordingServersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><v:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CamerasViewModel}"><v:CamerasView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StorageViewModel}"><v:StorageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GenericInventoryViewModel}"><v:GenericInventoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}"><v:MaintenanceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AutomationViewModel}"><v:AutomationView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CommandExplorerViewModel}"><v:CommandExplorerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><v:ActivityView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AddHardwareViewModel}"><v:AddHardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CsvImportViewModel}"><v:CsvImportView /></DataTemplate>
</ResourceDictionary>
