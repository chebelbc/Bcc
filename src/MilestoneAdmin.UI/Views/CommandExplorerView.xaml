<UserControl x:Class="MilestoneAdmin.UI.Views.CommandExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MilestoneAdmin.UI.ViewModels"
             xmlns:v="clr-namespace:MilestoneAdmin.UI.Views"
             xmlns:cat="clr-namespace:MilestoneAdmin.Domain.Catalog;assembly=MilestoneAdmin.Domain"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandExplorerViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <DataTemplate x:Key="Field.Text" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.List" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" />
                <TextBlock Text="One value per line." Style="{StaticResource Text.Muted}" FontSize="11" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Checkbox" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Flag}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Toggle" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Flag}" IsThreeState="True" FontWeight="SemiBold" ToolTip="Indeterminate = do not set this parameter" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Dropdown" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Field.AcceptedValues}" SelectedItem="{Binding Text}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.MultiSelect" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ObjectOption}">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Object" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ObjectOptions}" SelectedItem="{Binding SelectedObject}" DisplayMemberPath="Label" IsTextSearchEnabled="True" />
                <TextBlock Text="{Binding ObjectTypesText}" Style="{StaticResource Text.Muted}" FontSize="11" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.ObjectMulti" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding ObjectOptions}" MaxHeight="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ObjectOption}">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding ObjectTypesText}" Style="{StaticResource Text.Muted}" FontSize="11" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Credential" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="User name" />
                    <PasswordBox v:SecurePassword.Sink="{Binding}" Width="180" Margin="8,0,0,0" ToolTip="Password" />
                </StackPanel>
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Secret" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <PasswordBox v:SecurePassword.Sink="{Binding}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Date" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <DatePicker SelectedDate="{Binding Date}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Field.Unsupported" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="This parameter type cannot be entered in a form (script blocks are never accepted). Use the generated PowerShell instead." Style="{StaticResource Text.Muted}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <v:FieldTemplateSelector x:Key="FieldSelector"
                                 Text="{StaticResource Field.Text}" List="{StaticResource Field.List}" Checkbox="{StaticResource Field.Checkbox}"
                                 Toggle="{StaticResource Field.Toggle}" Dropdown="{StaticResource Field.Dropdown}" MultiSelect="{StaticResource Field.MultiSelect}"
                                 ObjectSelector="{StaticResource Field.Object}" ObjectMultiSelector="{StaticResource Field.ObjectMulti}"
                                 Credential="{StaticResource Field.Credential}" Secret="{StaticResource Field.Secret}" Date="{StaticResource Field.Date}"
                                 Unsupported="{StaticResource Field.Unsupported}" />
    </UserControl.Resources>
    <Grid>
        <DockPanel Margin="24,20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Command Explorer" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding CatalogInfo}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,12,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Search command names, aliases and synopsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="250" />
                            <ComboBox ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding RiskFilter}" Width="100" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="2*" />
                            <DataGridTemplateColumn Header="Risk" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommandRow}">
                                        <TextBlock Text="{Binding RiskText}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" Margin="6,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.PageTitle}" />
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Requirements}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                            <Button Content="Open online help" Command="{Binding OpenHelpCommand}" Style="{StaticResource Button.Link}" Margin="0,4,0,0" />
                            <TextBlock Text="Parameters" Style="{StaticResource Text.Section}" />
                            <ComboBox ItemsSource="{Binding ParameterSets}" SelectedItem="{Binding SelectedSet}" DisplayMemberPath="DisplayName" Margin="0,0,0,8" ToolTip="Ways to call this command" />
                            <TextBlock Text="{Binding Form.ExecutionBlockedReason}" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplateSelector="{StaticResource FieldSelector}" />
                            <TextBlock Text="{Binding Validation}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <Button Content="Preview PowerShell" Command="{Binding PreviewScriptCommand}" />
                                <Button Content="Copy" Command="{Binding CopyScriptCommand}" />
                                <Button Content="Export .ps1" Command="{Binding ExportScriptCommand}" />
                                <Button Content="Run -WhatIf" Command="{Binding WhatIfCommand}" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Text="Enable Expert Mode to run commands from this page." Style="{StaticResource Text.Muted}" Visibility="{Binding ExpertMode, Converter={StaticResource InvBoolToVis}}" />
                            <TextBox Text="{Binding Script, Mode=OneWay}" Style="{StaticResource Text.Code}" MinHeight="70" MaxHeight="220" />
                            <TextBlock Text="Result" Style="{StaticResource Text.Section}" />
                            <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                            <DataGrid ItemsSource="{Binding ResultData}" AutoGenerateColumns="True" MaxHeight="320" Margin="0,6,0,0" />
                            <TextBlock Text="Examples (from the MilestonePSTools help)" Style="{StaticResource Text.Section}" />
                            <ItemsControl ItemsSource="{Binding Examples}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type cat:CommandExample}">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding Code, Mode=OneWay}" Style="{StaticResource Text.Code}" />
                                            <TextBlock Text="{Binding Remarks}" Style="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
        <v:ErrorBanner VerticalAlignment="Top" />
        <v:BusyOverlay />
    </Grid>
</UserControl>
