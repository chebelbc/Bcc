<Window x:Class="MilestoneAdmin.UI.Views.StrongConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />
        <TextBox x:Name="Message" Margin="0,10,0,10" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="300" VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="Prompt" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
        <TextBox x:Name="Answer" TextChanged="OnTextChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ConfirmButton" Content="Confirm" IsEnabled="False" Click="OnConfirm" Style="{StaticResource Button.Danger}" />
            <Button Content="Cancel" IsCancel="True" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
